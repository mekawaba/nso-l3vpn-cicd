<ncs-package xmlns="http://tail-f.com/ns/ncs-packages">
  <name>l3vpn</name>
  <package-version>1.1</package-version>
  <description>L3VPN service for IOS XR PE routers</description>
  <ncs-min-version>6.7</ncs-min-version>

  <required-package>
    <name>cisco-iosxr-cli-7.76</name>
  </required-package>

  <component>
    <name>main</name>
    <application>
      <python-class-name>l3vpn.main.Main</python-class-name>
    </application>
  </component>
</ncs-package>
